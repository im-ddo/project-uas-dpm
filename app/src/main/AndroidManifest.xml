<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ataraxia">

        <!-- MAIN / LAUNCHER -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AUTH -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- DASHBOARD -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- MENU DETAIL -->
        <activity
            android:name=".KlikNasiGorengActivity"
            android:exported="false" />

        <activity
            android:name=".KlikMieGorengActivity"
            android:exported="false" />

        <activity
            android:name=".KlikBihunGorengActivity"
            android:exported="false" />

        <activity
            android:name=".KlikKwetiauGorengActivity"
            android:exported="false" />

        <!-- PEMBAYARAN (INI YANG TADI BIKIN ERROR) -->
        <activity
            android:name=".PembayaranSuksesActivity"
            android:exported="false" />

        <!-- NAVIGATION -->
        <activity
            android:name=".PesananActivity"
            android:exported="false" />

        <activity
            android:name=".PromoActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- FONT -->
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>
